[Unit]
Description=OpenPassword operator console
After=openpassword-broker.service
Requires=openpassword-broker.service

[Service]
Type=simple
DynamicUser=yes
User=openpassword-web
WorkingDirectory=/opt/openpassword/current
ExecStart=/opt/openpassword/current/node/bin/node node_modules/next/dist/bin/next start -H localhost -p 3000
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
InaccessiblePaths=-/var/lib/openpassword -/var/lib/private
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
