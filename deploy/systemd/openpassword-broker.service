[Unit]
Description=OpenPassword credential broker
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=openpassword-broker
StateDirectory=openpassword
StateDirectoryMode=0700
UMask=0077
WorkingDirectory=/opt/openpassword/current
ExecStart=/opt/openpassword/current/node/bin/node --import tsx server/main.ts
Environment=OPENPASSWORD_HOME=/var/lib/openpassword
Environment=OPENPASSWORD_WEB_ORIGIN=http://localhost:3000
Environment=NODE_ENV=production
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
